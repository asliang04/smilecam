{
  "name": "smilecam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, browser-local smile camera and object counter",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "postinstall": "npm run prepare:assets",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "test:models": "node test/models.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "engines": { "node": ">=22.12.0" }
}
